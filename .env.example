# Скопируйте в .env и вставьте ключ. Файл .env не попадает в git.
# Ключ Gemini (бесплатно): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# По умолчанию: Gemini через OpenAI-совместимый endpoint и модель gemini-3.8-flash.
# LLM_MODEL=gemini-3.5-flash-lite

# Любой другой OpenAI-совместимый провайдер (OpenAI, OpenRouter, Ollama, vLLM, LM Studio):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=

# Настройки прогона
# REQCHECK_CONCURRENCY=2      # параллельных запросов (2 для бесплатного Gemini)
# REQCHECK_MAX_RETRIES=5      # повторов при 429/5xx, пауза по Retry-After или 2, 4, 8 с
# REQCHECK_TIMEOUT=40
# REQCHECK_CRITIC_VOTES=1
# REQCHECK_DISABLE_THINKING=0
# REQCHECK_JSON_SCHEMA=1     # для сервера с поддержкой response_format=json_schema

# Резервная модель включается только при настройке обоих полей ниже.
# REQCHECK_BACKUP_BASE_URL=http://localhost:11434/v1
# REQCHECK_BACKUP_MODEL=qwen3:8b
# REQCHECK_BACKUP_API_KEY=   # отдельный ключ резервного сервера
# Для HTTPS API Google можно использовать GEMINI_API_KEY.
# REQCHECK_SWITCH_AFTER=30  # положительное конечное число секунд
# REQCHECK_BACKUP_JSON_SCHEMA=1  # только если резервный сервер поддерживает JSON Schema
